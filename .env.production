# ============================================================
# INTRANET ARCA DE CRISTO — Variables de entorno (Vite)
# Copie este archivo como .env para desarrollo local.
# En producción los valores viven en .env.production (valores públicos).
# NUNCA coloque secretos aquí: todo lo que empieza por VITE_ se incluye
# en el bundle del navegador. La SPA usa PKCE y no necesita client secret.
# ============================================================

# Registro de aplicación en Microsoft Entra ID (ver docs/M365_SETUP.md)
VITE_MSAL_CLIENT_ID=c69b1c39-4357-4b88-8634-01cde6235549
VITE_MSAL_TENANT_ID=b5fed600-8da6-43f1-8018-e741824c0e28
# Opcional: si se omite se usa el origen actual (http://localhost:5173 o la URL pública)
# VITE_MSAL_REDIRECT_URI=

# Sitio de SharePoint Online que se usa como base de datos (listas ARC_*)
# Si VITE_SPO_HOSTNAME se deja vacío, la app lo detecta desde el tenant.
VITE_SPO_HOSTNAME=arcadecristoeducationdr.sharepoint.com
VITE_SPO_SITE_PATH=/sites/IntranetArca
# Opcional: Id. del sitio (si se conoce) para evitar la resolución por nombre
# VITE_SPO_SITE_ID=

# Carpeta raíz en OneDrive para el repositorio documental
VITE_ONEDRIVE_ROOT_FOLDER=ArcaDeCristo

# Correos (separados por coma) que siempre tendrán rol administrativo
VITE_ADMIN_EMAILS=direccion@arcadecristo.edu.do

# Power Automate: URL del desencadenador "Cuando se recibe una solicitud HTTP"
# del flujo de envío de correos (ver docs/POWERAUTOMATE.md). Si está vacía,
# el correo se envía con Microsoft Graph desde la cuenta del usuario conectado.
VITE_POWER_AUTOMATE_MAIL_URL=

# Copilot Studio: URL de inserción del agente (opcional)
VITE_COPILOT_EMBED_URL=
